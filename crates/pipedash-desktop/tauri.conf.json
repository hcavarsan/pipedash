{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'"
    },
    "windows": [
      {
        "backgroundColor": "#242424",
        "decorations": false,
        "height": 1000,
        "title": "Pipedash",
        "width": 1700
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "mise run build:front",
    "beforeDevCommand": "mise run dev:front",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../pipedash-web/dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  },
  "identifier": "com.henrique.pipedash",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/hcavarsan/pipedash/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5ODRCNjk3OThEQURBMUUKUldRZTJ0cVlsN2FFQ1lITDZKZk4rTCsza3BYeXA0czB3bUg3U3BBWHBTbS9ycml1cUhSWDFaTjYK"
    }
  },
  "productName": "pipedash",
  "version": "0.13.0"
}